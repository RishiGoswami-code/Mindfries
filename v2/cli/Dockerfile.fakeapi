# The fake V2 API, for a throwaway deployment (see DEPLOY-FAKEAPI.md).
# Not the real V2 API: everything is in memory and lost on restart.
#
# Build with the v2/ folder as the context, because the CLI depends on
# ../contracts:  docker build -f cli/Dockerfile.fakeapi v2   (on Render:
# Root Directory v2, Dockerfile Path cli/Dockerfile.fakeapi).
#
# It also hosts dev builds of the CLI with CLI_API baked in, so a tester
# installs with one command and types `mindfries start`, nothing else.
FROM golang:1.25-alpine AS build
RUN apk add --no-cache git
WORKDIR /src
COPY contracts ./contracts
COPY cli ./cli
WORKDIR /src/cli
RUN CGO_ENABLED=0 go build -trimpath -o /out/fakeapi ./cmd/fakeapi
# The address the hosted CLI builds talk to: this service's own.
ARG CLI_API=https://mindfries-cli.onrender.com/v2/cli
RUN set -eu; pkg=github.com/mindfries/v2/cli/internal; mkdir -p /out/dist; \
    for t in windows/amd64 windows/arm64 darwin/amd64 darwin/arm64 linux/amd64 linux/arm64; do \
      os=${t%/*}; arch=${t#*/}; ext=""; [ "$os" = windows ] && ext=".exe"; \
      GOOS=$os GOARCH=$arch CGO_ENABLED=0 go build -trimpath \
        -ldflags "-s -w -X $pkg/buildinfo.DefaultAPI=$CLI_API -X $pkg/buildinfo.TrustDevKey=1" \
        -o "/out/dist/mindfries_${os}_${arch}${ext}" ./cmd/mindfries; \
    done

FROM alpine:3.20
# git is needed to check submitted bundles.
RUN apk add --no-cache git ca-certificates && adduser -D -u 10001 app
USER app
COPY --from=build /out/fakeapi /usr/local/bin/fakeapi
COPY --from=build /out/dist /srv/dist
ENV PORT=10000 FAKEAPI_DIST=/srv/dist
EXPOSE 10000
ENTRYPOINT ["fakeapi"]
